# Shared runtime configuration. Keep secrets out of source control.
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgres://phonarch:phonarch@127.0.0.1:5432/phonarch?sslmode=disable

# Two SIP edge instances. In production these are separate hosts/NICs and
# each public SIP address maps to the corresponding private bind address.
SIPGO_BIND_ADDRESSES=0.0.0.0:5060
SIPGO_TCP_BIND_ADDRESSES=0.0.0.0:5060
SIPGO_HTTP_ADDRESSES=127.0.0.1:8080
SIPGO_ADVERTISE_IPS=127.0.0.1
SIPGO_PUBLIC_IPS=
SIPGO_HTTP_TARGETS=127.0.0.1:8080
SIPGO_PROVIDER_SBC=
SIPGO_HEARTBEAT_LEASE=7s
PHONARCH_DTMF_EVENT_URL=http://127.0.0.1:8081/internal/v1/dtmf
PHONARCH_INTERNAL_TOKEN=

# Control API
CONTROL_API_LISTEN=127.0.0.1:8081
CONTROL_API_PUBLIC_URL=http://127.0.0.1:8081
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
DEFAULT_WORKSPACE_SLUG=operations
ROOM_MAX_ACTIVE_SPEAKERS=16

# UI
NEXT_PUBLIC_CONTROL_API_URL=http://127.0.0.1:8081
UI_PORT=3000

# Sidecar defaults
RUSTPBX_BIN=/opt/rustpbx/bin/rustpbx
RUSTPBX_CONTROL_URL=http://127.0.0.1:9090
SIDECAR_EVENT_URL=http://127.0.0.1:8081/internal/v1/events
SIDECAR_HEARTBEAT_INTERVAL=2s
NODE_ROLE=listener
NODE_DRAIN_STATE=READY
NODE_CAPACITY=500
CORE_PRIVATE_IPS=127.0.0.1
CORE_MEDIA_PUBLIC_IPS=127.0.0.1
CORE_SIP_PORTS=5071
CORE_RUSTPBX_CONTROL_ADDRESSES=127.0.0.1:9091
CORE_SIDECAR_ADDRESSES=127.0.0.1:9441
CORE_ROLES=listener
# For a real RustPBX binary, provide one config per CORE_PRIVATE_IPS entry:
# RUSTPBX_CONFIG_PATHS=/data/components/phonarch-rustpbx/config.toml

# Batch dialer
BATCH_MAX_CONCURRENCY=16
BATCH_CALLS_PER_SECOND=8
